<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOGS" value="./logs" />

    <!-- Консольный аппендер -->
    <appender name="Console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>
    </appender>

    <!-- Файловый аппендер для всех логов -->
    <appender name="RollingFile" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOGS}/embed-file.log</file>
        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n
            </pattern>
        </encoder>

        <!-- ИСКУССТВЕННОЕ ИЗМЕНЕНИЕ: Используем SizeAndTimeBasedRollingPolicy напрямую -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOGS}/archived/embed-file-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <!-- Параметр размера файла теперь указывается прямо здесь -->
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
    </appender>

    <!-- Специфичные логгеры -->
    <logger name="ru.ruslan" level="DEBUG" additivity="false">
        <appender-ref ref="Console" />
        <appender-ref ref="RollingFile" />
    </logger>

    <logger name="ru.ruslan.service.impl.OracleDbService" level="DEBUG" />
    <logger name="ru.ruslan.service.impl.PostgreSqlDbService" level="DEBUG" />
    <logger name="ru.ruslan.service.impl.RestClientService" level="DEBUG" />

    <logger name="org.springframework" level="INFO" />
    <logger name="org.springframework.jdbc" level="DEBUG" />

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="Console" />
        <appender-ref ref="RollingFile" />
    </root>
</configuration>